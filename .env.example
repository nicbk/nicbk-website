# Template for the git-ignored .env file. Every variable the app reads is
# declared in src/env.ts (the Zod schema) and documented here.
#
# Everything under "Required" must be set before the server will start —
# src/env.ts validates at startup and throws naming the offending variable.
# All of these are server-only secrets/config: never prefix them with VITE_,
# which would inline them into the client bundle.

# --- Optional (defaults shown) ------------------------------------------

# Runtime environment: development | production | test. Default: development.
#NODE_ENV=development

# Port the app server listens on. Default: 3000.
#PORT=3000

# --- Required: database ---------------------------------------------------

# Credentials the Postgres container initializes itself with. Read by Compose
# (not by the app), so they must agree with DATABASE_URL below.
POSTGRES_USER=nicbk
POSTGRES_PASSWORD=
POSTGRES_DB=nicbk

# Postgres connection string the app uses. Inside the Compose stack the host
# is the `db` service; for a server run outside Docker use localhost and the
# port docker-compose.override.yml publishes (5432).
DATABASE_URL=postgres://nicbk:PASSWORD@db:5432/nicbk

# --- Required: authentication ---------------------------------------------

# Signing key for Better Auth's session tokens (min. 32 chars). Generate a
# fresh one per environment and never commit it:
#   openssl rand -base64 48
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=

# The app's own public base URL. Better Auth builds OAuth callback URLs from
# it, so it must exactly match the redirect URI registered with Google.
# Production: https://nicbk.com — local development: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client credentials, from the Google Cloud console
# (APIs & Services → Credentials → OAuth 2.0 Client ID, type "Web
# application"). The authorized redirect URI must be
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
