# Template for the git-ignored .env file. Every variable the app reads is
# declared in src/env.ts (the Zod schema) and documented here.
#
# Everything under "Required" must be set before the server will start —
# src/env.ts validates at startup and throws naming the offending variable.
# All of these are server-only secrets/config and must never be prefixed with
# VITE_, which would inline them into the client bundle. The single exception is
# VITE_ZERO_CACHE_URL at the bottom, which is public by construction and
# documented there.

# --- Optional (defaults shown) ------------------------------------------

# Runtime environment: development | production | test. Default: development.
#NODE_ENV=development

# Port the app server listens on. Default: 3000.
#PORT=3000

# --- Required: database ---------------------------------------------------

# Credentials the Postgres container initializes itself with. Read by Compose
# (not by the app), so they must agree with DATABASE_URL below.
POSTGRES_USER=nicbk
POSTGRES_PASSWORD=
POSTGRES_DB=nicbk

# Postgres connection string the app uses. Inside the Compose stack the host
# is the `db` service; for a server run outside Docker use localhost and the
# port docker-compose.override.yml publishes (5432).
DATABASE_URL=postgres://nicbk:PASSWORD@db:5432/nicbk

# --- Required: authentication ---------------------------------------------

# Signing key for Better Auth's session tokens (min. 32 chars). Generate a
# fresh one per environment and never commit it:
#   openssl rand -base64 48
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=

# The app's own public base URL. Better Auth builds OAuth callback URLs from
# it, so it must exactly match the redirect URI registered with Google.
# Production: https://nicbk.com — local development: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client credentials, from the Google Cloud console
# (APIs & Services → Credentials → OAuth 2.0 Client ID, type "Web
# application"). The authorized redirect URI must be
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Required: Zero sync engine -------------------------------------------

# Shared secrets proving a call to /api/zero/query or /api/zero/mutate came
# from zero-cache, which sends them in an X-Api-Key header. Both sides read the
# same variable, so one value each. They do not decide which user's data a
# request may read — the session cookie does that — they keep the sync engine's
# callbacks from being open endpoints on the public app server. Min. 32 chars;
# generate a fresh one per environment:
#   openssl rand -base64 48
ZERO_QUERY_API_KEY=
ZERO_MUTATE_API_KEY=

# Password for zero-cache's own admin surfaces (/statz and the inspector).
# Read by the zero-cache container only, not by the app — the same arrangement
# as POSTGRES_* above. Required in production; set it everywhere so `up` fails
# loudly rather than starting an unprotected one.
ZERO_ADMIN_PASSWORD=

# zero-cache's remaining connection settings are not listed here because they
# are derived in docker-compose.yml: ZERO_UPSTREAM_DB / ZERO_CVR_DB /
# ZERO_CHANGE_DB all come from DATABASE_URL above, and the SQLite replica lives
# on a named volume.

# --- Required: Garage blob store ------------------------------------------

# Credentials the app uses to read and write PDFs. Garage fixes the shape of an
# access key ID — the literal prefix GK followed by hex — so generate a pair
# rather than inventing one:
#   echo "GK$(openssl rand -hex 12)"    # access key ID
#   openssl rand -hex 32                # secret access key
# The bootstrap job imports exactly these values into Garage on `up`
# (scripts/garage-init.mjs), which is why they are chosen here rather than
# generated by Garage and copied back out.
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# The bucket every uploaded PDF lands in, under
# lit-tracker/{user_id}/{article_id}/source.pdf. One bucket for the whole site;
# separation between users is the key prefix plus the app server's own
# authorization, never a bucket boundary.
GARAGE_BUCKET=nicbk-website

# Cluster secrets read by the Garage container (and, for the admin token, by
# the bootstrap job) — not by the app, the same arrangement as POSTGRES_* above.
# The RPC secret must be exactly 32 hex-encoded bytes; the admin token is free
# form. Generate both fresh per environment:
#   openssl rand -hex 32     # GARAGE_RPC_SECRET
#   openssl rand -base64 32  # GARAGE_ADMIN_TOKEN
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Where the APP reaches Garage's S3 API. Inside the Compose stack that is the
# `garage` service; for a server run outside Docker use localhost and the port
# docker-compose.override.yml publishes (3900).
GARAGE_ENDPOINT=http://garage:3900

# --- Required: zero-cache's public address --------------------------------

# Where the BROWSER connects to zero-cache. The only VITE_-prefixed variable in
# this project, and deliberately so: the browser opens this WebSocket itself, so
# the address is public by construction. Nothing authorizing travels with it —
# the session cookie does that, and /api/zero/query decides what may be read.
#
# Vite INLINES this at build time rather than reading it at startup, so it must
# be set before `docker compose build`, not just before `up`. Compose passes it
# through as a build arg (see docker-compose.yml).
#
# Local: zero-cache's published port directly. No proxy is needed because
# browsers key cookies by host and ignore the port, so the cookie set on
# localhost:3000 is already sent to localhost:4848.
# Production: same-origin with one path segment, e.g. https://nicbk.com/zero,
# with nginx proxying /zero/ through to zero-cache untouched (zero-cache's
# router accepts a leading base segment; do not strip it). Same-origin is what
# lets the browser send the session cookie without widening that cookie to every
# subdomain of the site.
VITE_ZERO_CACHE_URL=http://localhost:4848
