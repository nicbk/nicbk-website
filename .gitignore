# Dependencies
node_modules/

# Build output
dist/
.output/
.nitro/
.tanstack/

# Environment files — secrets are provisioned manually per host and never
# committed (see research/devops-deployment/secrets-and-environment-config.md).
# .env.example stays committed as the template.
.env
.env.local
.env.*.local

# Generated CSS Modules type declarations (`npx cmk`, runs with typecheck)
generated/

# Test artifacts
coverage/
test-results/
playwright-report/
# The session the signed-in e2e tier signs in for once per run
# (e2e-auth/support/session-state.ts). A real cookie for the stubbed account,
# rewritten every run and never shared between them.
e2e-auth/.auth/

# OS / editor noise
.DS_Store
*.log
