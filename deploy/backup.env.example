# The backup environment file: a template (features/backups-you-can-relaunch-from).
#
# Copy to a root-only file outside the repository, for example
# /var/lib/nicbk-website-backup/backup.env with mode 0600, and point
# `services.nicbk-website.backup.environmentFile` at it. It is separate from the
# app's .env on purpose: the app never needs, and so never holds, the keys to
# its own backups. deploy/README-backups.md says how to get each value.

# The restic repository on Backblaze B2, through B2's S3 API:
#   s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
# restic's encryption password. Irrecoverable if lost: a copy lives in the
# break-glass set, off this node.
RESTIC_PASSWORD=

# The node's B2 application key: listFiles, readFiles and writeFiles, but NOT
# deleteFiles, and restricted to the backup bucket. Without deleteFiles a
# delete only hides a file, and the bucket's lifecycle rule erases hidden files
# after 30 days, so a compromised node cannot destroy the history (BK8, P32-1).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket's region, the <region> in the repository URL above.
AWS_DEFAULT_REGION=

# The operator's ntfy topic, as a full URL (https://ntfy.sh/<topic>). Every
# failed job, and the size ceiling removing history, posts here.
NTFY_URL=
