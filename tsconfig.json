{
  "compilerOptions": {
    // Language/output targets — TanStack Start's documented baseline.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],

    // Vite owns emit; tsc is typecheck-only (`npm run typecheck`).
    "noEmit": true,
    "skipLibCheck": true,

    // The test tooling has a handful of plain-JavaScript modules — the e2e
    // service constants and the upstream-API stubs — which are `.mjs` because
    // the signed-in-suite launcher (scripts/e2e-auth-server.mjs) runs them
    // under bare `node`, with no build step to transpile them first. `allowJs`
    // lets TypeScript *infer* their shapes where a spec imports them, so those
    // imports are typed from the source of truth. The alternative, a
    // hand-written `.d.mts` beside each one, is a second copy of every
    // signature that nothing keeps honest.
    //
    // `checkJs` stays off: these files are not written to this project's
    // TypeScript standard and are not being held to it.
    "allowJs": true,

    // Strictness: `strict` plus the agreed low-friction extras.
    // `exactOptionalPropertyTypes` is deliberately NOT enabled — see
    // research/coding-conventions/typescript-conventions.md.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // Keeps type-only imports explicit (`import { type Foo }`), pairing
    // with Biome's `useImportType` inlineType style.
    "verbatimModuleSyntax": true,

    // `~/` alias for cross-cutting imports (relative imports stay relative
    // for nearby/colocated code) — see
    // research/coding-conventions/import-conventions.md.
    "paths": {
      "~/*": ["./src/*"],
      // The blog content root lives at the repo root (a self-contained unit:
      // its posts, frontmatter schema, and data layer), so it gets its own
      // alias rather than being reachable only by deep relative paths.
      "~blog/*": ["./blog/*"]
    },

    // Overlays generated/src onto src so *.module.css imports resolve to
    // the exact-key .d.ts files cmk generates (see cmkOptions below).
    "rootDirs": ["src", "generated/src"]
  },
  "include": [
    "src",
    "blog",
    // The Playwright suites and the configs that drive them. They were outside
    // this list until 2026-08-09, which meant a spec could reference a symbol
    // that did not exist and nothing said so until the browser ran it — the way
    // a missing import in an e2e spec surfaced during #7.
    "e2e",
    "e2e-auth",
    "playwright.config.ts",
    "playwright.auth.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    // drizzle-zero resolves the Drizzle schema's types through its config
    // file, and fails with "Failed to find type definitions" unless that file
    // is inside the project tsc knows about. (drizzle.config.ts is deliberately
    // not included: Drizzle Kit reads it directly, and typechecking it under
    // noPropertyAccessFromIndexSignature would demand a process.env access
    // Biome's useLiteralKeys then rejects.)
    "drizzle-zero.config.ts"
  ],
  // Generates exact-key .d.ts files for *.module.css (via `npx cmk`, wired
  // into the typecheck script), so the decided dot-notation access to CSS
  // Modules composes with noPropertyAccessFromIndexSignature — and class
  // name typos fail the typecheck. Resolution recorded in
  // research/coding-conventions/typescript-conventions.md.
  "cmkOptions": {
    "enabled": true
  }
}
